datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  userRank     String       @default("Bhubaneswar Explorer")
  points       Int          @default(100)
  role         String       @default("EXPLORER")
  guildId      String?
  guild        Guild?       @relation(fields: [guildId], references: [id])
  posts        Post[]
  likes        PostLike[]
  discoveries  Discovery[]
  timeCapsules TimeCapsule[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([points])
  @@index([guildId, points])
  @@index([createdAt])
}

model Guild {
  id          String   @id @default(uuid())
  name        String   @unique
  region      String
  totalPoints Int      @default(0)
  members     User[]
  createdAt   DateTime @default(now())

  @@index([totalPoints])
}

model Monument {
  id                      String        @id
  name                    String
  locationName            String
  latitude                Float
  longitude               Float
  pointsValue             Int           @default(500)
  category                String
  isVerified              Boolean       @default(true)
  custodianId             String?
  totalContributionPoints Int           @default(0)
  posts                   Post[]
  timeCapsules            TimeCapsule[]
  discoveries             Discovery[]
  createdAt               DateTime      @default(now())

  @@index([latitude, longitude])
  @@index([category, name])
}

model Post {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  monumentId String
  monument   Monument   @relation(fields: [monumentId], references: [id], onDelete: Cascade)
  caption    String
  imageUrl   String?
  postType   String     @default("CHECKIN")
  createdAt  DateTime   @default(now())
  likes      PostLike[]

  @@index([createdAt, id])
  @@index([userId, createdAt])
  @@index([monumentId, createdAt])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model Discovery {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monumentId   String
  monument     Monument @relation(fields: [monumentId], references: [id], onDelete: Cascade)
  imageUrl     String?
  pointsEarned Int      @default(1000)
  isFirst      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([userId, monumentId])
  @@index([monumentId, createdAt])
  @@index([userId, createdAt])
}

model TimeCapsule {
  id         String   @id @default(uuid())
  monumentId String
  monument   Monument @relation(fields: [monumentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now())

  @@index([monumentId, createdAt])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
