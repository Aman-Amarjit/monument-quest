datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  avatarUrl    String?
  userRank     String       @default("Bhubaneswar Explorer")
  points       Int          @default(0)
  streakDays   Int          @default(0)
  totalDistanceKm Float     @default(0)
  areaUnlockedKm2 Float     @default(0)
  walkPathJson String        @default("[]")
  exploredZonesJson String   @default("[]")
  role         String        @default("EXPLORER")
  guildId      String?
  guild        Guild?        @relation(fields: [guildId], references: [id], onDelete: SetNull)
  posts        Post[]
  likes        PostLike[]
  comments     Comment[]
  discoveries  Discovery[]
  timeCapsules TimeCapsule[]
  following    Follow[]       @relation("following")
  followers    Follow[]       @relation("followers")
  savedPosts   SavedPost[]
  stories      Story[]
  storyViews   StoryView[]
  reports      PostReport[]   @relation("postReportsByUser")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([points])
  @@index([guildId, points])
  @@index([createdAt])
}

model Guild {
  id          String   @id @default(uuid())
  name        String   @unique
  region      String
  description String   @default("")
  totalPoints Int      @default(0)
  members     User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([totalPoints])
}

model Monument {
  id                      String        @id
  name                    String
  locationName            String
  latitude                Float
  longitude               Float
  pointsValue             Int           @default(500)
  category                String
  isVerified              Boolean       @default(true)
  custodianId             String?
  totalContributionPoints Int           @default(0)
  posts                   Post[]
  timeCapsules            TimeCapsule[]
  discoveries             Discovery[]
  createdAt               DateTime      @default(now())

  @@index([latitude, longitude])
  @@index([category, name])
}

model Post {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  monumentId String
  monument   Monument   @relation(fields: [monumentId], references: [id], onDelete: Cascade)
  caption    String
  imageUrl   String?
  postType   String     @default("CHECKIN")
  visibility String     @default("PUBLIC")
  createdAt  DateTime   @default(now())
  likes      PostLike[]
  comments   Comment[]
  savedBy    SavedPost[]
  reports    PostReport[]

  @@index([userId, createdAt])
  @@index([monumentId, createdAt])
  @@index([visibility, createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model SavedPost {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model Story {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl  String
  caption   String      @default("")
  expiresAt DateTime
  createdAt DateTime    @default(now())
  views     StoryView[]

  @@index([expiresAt, createdAt])
  @@index([userId, expiresAt])
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([storyId, userId])
  @@index([userId, viewedAt])
}

model PostReport {
  id         String   @id @default(uuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation("postReportsByUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())

  @@unique([postId, reporterId])
  @@index([status, createdAt])
}

model Discovery {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monumentId String
  monument   Monument @relation(fields: [monumentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, monumentId])
}

model TimeCapsule {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monumentId String
  monument   Monument @relation(fields: [monumentId], references: [id], onDelete: Cascade)
  message    String
  mediaUrl   String?
  unlockAt   DateTime
  createdAt  DateTime @default(now())

  @@index([monumentId, unlockAt])
}

model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime
}
