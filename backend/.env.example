# MonumentQuest Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/monumentquest?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/monumentquest?schema=public"

# Server Configuration
PORT=3000
NODE_ENV=production
TRUST_PROXY=true

# CORS Configuration
# For Android app, you can use "*" or specify your backend URL
CORS_ORIGIN=*

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Supabase (Optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Email Configuration (Gmail App Password for OTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=60

# AI Configuration (Optional - Groq)
GROQ_API_KEY=
