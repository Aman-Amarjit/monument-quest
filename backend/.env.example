# PostgreSQL is required. Use a pooled connection for serverless deployments when available.
DATABASE_URL="postgresql://user:password@localhost:5432/monumentquest?schema=public&connection_limit=20&pool_timeout=10"
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8080
TRUST_PROXY=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
SUPABASE_URL=
SUPABASE_ANON_KEY=
GROQ_API_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=30
