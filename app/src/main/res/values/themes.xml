<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Use DayNight so the system window is dark before Compose draws its first frame.
         This eliminates the white flash on cold start that the Light parent caused. -->
    <style name="Theme.MonumentQuest" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
